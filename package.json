{
  "name": "react-chrome-extension-template-side-panel",
  "version": "0.2.0",
  "license": "MIT",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "prestart": "yarn style",
    "start": "parcel watch public/manifest.json --config @parcel/config-webextension --host localhost",
    "prebuild": "yarn style && rm -rf ./public/dist",
    "build": "parcel build public/manifest.json --config @parcel/config-webextension --no-content-hash --no-source-maps --no-cache",
    "style": "npx tailwindcss -i ./src/input.css -o ./src/content.css",
    "style:watch": "yarn style -- --watch"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "react": "^18.2.0",
    "react-app-polyfill": "^3.0.0",
    "react-dom": "^18.2.0",
    "react-frame-component": "^5.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.0.19",
    "@types/react-dom": "^18.0.6",
    "@parcel/config-webextension": "2.7.0",
    "parcel": "2.7.0",
    "postcss": "^8.4.16",
    "postcss-nested": "^5.0.6",
    "process": "^0.11.10",
    "tailwindcss": "^3.1.8",
    "typescript": "^4.8.3"
  }
}
