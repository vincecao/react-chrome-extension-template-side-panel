{
  "short_name": "react-chrome-extension-template-side-panel",
  "name": "React Chrome Extension Template: Side Panel",
  "version": "0.2.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["../src/content.css"],
      "js": ["../src/content.tsx"]
    }
  ],
  "permissions": ["storage", "scripting", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
